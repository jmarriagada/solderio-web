# ==============================================================================
# SOLDERÍO WEB - VARIABLES DE ENTORNO EN PRODUCCIÓN
# ==============================================================================

# Dominio y URL Base
NEXT_PUBLIC_SITE_URL=https://solderio.cl
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. SUPABASE (Reemplaza a Firebase Auth & Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://[TU_PROYECTO].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1...

# ------------------------------------------------------------------------------
# 2. PRISMA & BASE DE DATOS (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# URL de conexión pooling (puerto 6543) para el servidor (API / Next.js)
DATABASE_URL="postgresql://postgres.[PROYECTO]:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL de conexión directa (puerto 5432) usada SOLAMENTE por Prisma para migraciones
DIRECT_URL="postgresql://postgres.[PROYECTO]:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK (Privado para Servidor y API Routes)
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@solderio-web.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. WEBHOOKS & MOTOR DE AUTOMATIZACIÓN (n8n / Make)
# ------------------------------------------------------------------------------
EXTERNAL_WEBHOOK_URL=https://n8n.solderio.cl/webhook/solderio-leads
WEBHOOK_SECRET=sol_sec_2026_prod_key

# ------------------------------------------------------------------------------
# 4. CREDENCIALES DE N8N (Para configurar en el entorno de n8n)
# ------------------------------------------------------------------------------
# WHATSAPP_PHONE_NUMBER_ID=109876543210987
# WHATSAPP_ACCESS_TOKEN=EAAxxxxxx...
# RESEND_API_KEY=re_123456789...
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_TEAM_CHAT_ID=-1001234567890
