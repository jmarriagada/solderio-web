NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK (Privado para Servidor y API Routes)
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@solderio-web.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. WEBHOOKS & MOTOR DE AUTOMATIZACIÓN (n8n / Make)
# ------------------------------------------------------------------------------
EXTERNAL_WEBHOOK_URL=https://n8n.solderio.cl/webhook/solderio-leads
WEBHOOK_SECRET=sol_sec_2026_prod_key

