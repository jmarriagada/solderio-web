NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=solderio-web.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=solderio-web
